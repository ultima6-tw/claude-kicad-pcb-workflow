	(model "${KICAD10_3DMODEL_DIR}/Connector_Samtec.3dshapes/Samtec_LSHM-130-xx.x-x-DV-S_2x30-1SH_P0.50mm_Vertical.step"
		(offset (xyz 0.0 21.0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
